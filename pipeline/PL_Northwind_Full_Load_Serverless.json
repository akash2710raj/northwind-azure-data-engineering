{
	"name": "PL_Northwind_Full_Load_Serverless",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Northwind_Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT\r\n    s.name AS schema_name,\r\n    t.name AS table_name\r\nFROM sys.tables t\r\nINNER JOIN sys.schemas s\r\n    ON t.schema_id = s.schema_id\r\nWHERE t.is_ms_shipped = 0\r\nORDER BY s.name, t.name;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_Northwind_Customers",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Northwind_Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Northwind_Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Northwind_Tables').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy_Northwind_Table",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_Northwind_SQL_Dynamic",
									"type": "DatasetReference",
									"parameters": {
										"schemaName": {
											"value": "@item().schema_name",
											"type": "Expression"
										},
										"tableName": {
											"value": "@item().table_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Northwind_ADLS_Dynamic",
									"type": "DatasetReference",
									"parameters": {
										"folderName": {
											"value": "@replace(toLower(item().table_name), ' ', '_')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Northwind_Bronze_Serverless_Job",
							"type": "DatabricksJob",
							"dependsOn": [
								{
									"activity": "Copy_Northwind_Table",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"jobId": "162204685515375",
								"jobParameters": {
									"tableName": {
										"value": "@item().table_name",
										"type": "Expression"
									},
									"folderName": {
										"value": "@replace(toLower(item().table_name), ' ', '_')",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "Northwind_Databricks_Serverless",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-08-26T11:25:47Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}